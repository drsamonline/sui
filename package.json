{
  "name": "sui",
  "version": "0.12.38",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Sui — verification-first, privacy-aware free-tier AI gateway. Free tiers, verified before use.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/cli/bin/sui.js start",
    "dev": "node --watch apps/cli/bin/sui.js start",
    "test": "node scripts/test.mjs",
    "eval": "node evals/run.mjs",
    "eval:self": "node evals/run.mjs --self-test",
    "soak": "node scripts/soak.mjs --minutes 1",
    "doctor": "node apps/cli/bin/sui.js doctor",
    "link": "node scripts/link-workspaces.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "tokens": "node apps/cli/bin/sui.js tokens --check",
    "kits": "node apps/cli/bin/sui.js kits",
    "probe": "node apps/cli/bin/sui.js probe",
    "audit": "node scripts/audit.mjs && node scripts/adr-check.mjs",
    "adr": "node scripts/adr-check.mjs",
    "publish:dry": "node scripts/publish.mjs --dry-run",
    "publish:real": "node scripts/publish.mjs",
    "adr:gate": "node scripts/adr-gate.mjs",
    "import:9router": "node scripts/import-9router.mjs",
    "import:endpoints": "node scripts/import-endpoints.mjs",
    "import:all": "node scripts/import-9router.mjs && node scripts/import-endpoints.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:sync:online": "node scripts/sync-catalog.mjs --online",
    "smoke:dashboard": "node scripts/smoke-dashboard.mjs"
  },
  "bin": {
    "sui": "./apps/cli/bin/sui.js"
  },
  "dependencies": {},
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/drsamonline/sui.git"
  },
  "keywords": [
    "llm",
    "gateway",
    "router",
    "free-tier",
    "openai-compatible",
    "verification",
    "privacy"
  ],
  "homepage": "https://drsamonline.github.io/sui/",
  "bugs": {
    "url": "https://github.com/drsamonline/sui/issues"
  },
  "author": "Dr Sohil Momin"
}
