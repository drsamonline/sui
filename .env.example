# Copy to .env and fill in only the providers you actually use.
# Sui reads these at request time; a provider with no key is skipped, not crashed on.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: protects the gateway when it is reachable beyond localhost.
# SUI_API_KEY=

# Where sui keeps its ledger and cache. Defaults to ~/.sui
# SUI_HOME=
