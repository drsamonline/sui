{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sui-router.dev/sui.schema.json",
  "title": "sui-router config",
  "type": "object",
  "required": [
    "providers",
    "models",
    "combos"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 8787
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "ttlMs": {
              "type": "integer",
              "minimum": 0,
              "default": 900000
            },
            "maxEntries": {
              "type": "integer",
              "minimum": 1,
              "default": 500
            }
          }
        },
        "allowedHosts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Host headers this gateway answers to. null means the safe default: 127.0.0.1, localhost, [::1]."
        },
        "corsOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Origins allowed to call this gateway from a browser. Empty (the default) means same-origin only: a page on another site cannot read answers or spend quota. Use [\"*\"] only on a network you trust."
        }
      }
    },
    "providers": {
      "type": "object",
      "description": "Keyed by the id you use in models[].provider.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "openai",
              "anthropic",
              "gemini",
              "mock",
              "mcp"
            ]
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "apiKeyEnv": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the env var holding the key. null means this endpoint needs no key (Ollama, vLLM, LM Studio)."
          },
          "apiKey": {
            "type": "string",
            "description": "Discouraged: prefer apiKeyEnv so the key stays out of the repo."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 60000
          },
          "local": {
            "type": "boolean",
            "description": "Treat as keyless and local."
          },
          "mock": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "delayMs": {
                "type": "integer",
                "minimum": 0
              },
              "failWith": {
                "type": "string"
              },
              "failStatus": {
                "type": "integer"
              },
              "failCode": {
                "type": "string"
              },
              "failRetryable": {
                "type": "boolean"
              }
            }
          },
          "tier": {
            "enum": [
              "free",
              "paid",
              "local",
              "demo"
            ]
          },
          "tos": {
            "enum": [
              "allowed",
              "review",
              "avoid"
            ]
          },
          "privacy": {
            "type": "object",
            "additionalProperties": false,
            "description": "What this provider does with what you send it.",
            "properties": {
              "retention": {
                "enum": [
                  "none",
                  "session",
                  "short",
                  "long",
                  "unknown"
                ],
                "default": "unknown"
              },
              "trainsOnData": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "region": {
            "enum": [
              "any",
              "eu",
              "us",
              "in",
              "uk",
              "apac",
              "unknown"
            ],
            "default": "unknown",
            "description": "B6.6: where this provider processes data. An unmarked provider cannot satisfy a residency requirement."
          },
          "oauth": {
            "type": "object",
            "additionalProperties": false,
            "description": "B9.5: refresh a short-lived access token once on a 401, then retry once.",
            "properties": {
              "tokenUrl": {
                "type": "string"
              },
              "clientIdEnv": {
                "type": "string"
              },
              "clientSecretEnv": {
                "type": "string"
              },
              "refreshTokenEnv": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            }
          },
          "tool": {
            "type": "string",
            "description": "B5.4: the MCP tool that answers a chat request."
          },
          "url": {
            "type": "string",
            "description": "MCP HTTP endpoint."
          },
          "command": {
            "type": "string",
            "description": "MCP stdio command to launch."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "argument": {
            "type": "string",
            "default": "prompt",
            "description": "Which tool argument carries the prompt."
          },
          "systemArgument": {
            "type": "string",
            "description": "Which tool argument carries the system message, if any."
          },
          "maxTokensArgument": {
            "type": "string"
          },
          "transport": {
            "enum": [
              "stdio",
              "http"
            ]
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "The provider's own model name."
          },
          "label": {
            "type": "string",
            "description": "Plain-language name shown in the selector."
          },
          "costPer1kIn": {
            "type": "number",
            "minimum": 0
          },
          "costPer1kOut": {
            "type": "number",
            "minimum": 0
          },
          "quality": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "tier": {
            "enum": [
              "free",
              "paid",
              "local",
              "demo"
            ]
          },
          "contextWindow": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "combos": {
      "type": "object",
      "description": "Virtual models your tools call.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "strategy",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "strategy": {
            "enum": [
              "fallback",
              "weighted",
              "cheapest",
              "latency"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "model"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "model": {
                      "type": "string"
                    },
                    "weight": {
                      "type": "number",
                      "minimum": 0
                    },
                    "arm": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "minQuality": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "maxCostPer1k": {
            "type": "number",
            "minimum": 0
          },
          "learning": {
            "type": "object",
            "additionalProperties": false,
            "description": "B9.3 fallback learning: reorder this combo's targets by measured health from the ledger.",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "minSamples": {
                "type": "integer",
                "minimum": 1,
                "default": 10
              },
              "windowMs": {
                "type": "integer",
                "minimum": 60000,
                "default": 86400000
              }
            }
          },
          "cascade": {
            "type": "object",
            "additionalProperties": false,
            "description": "B3.5 speculative cascade: pick targets from a sub-50ms classification of the prompt.",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              },
              "simple": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "complex": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "longWords": {
                "type": "integer",
                "minimum": 20,
                "default": 120
              }
            }
          },
          "freeFirst": {
            "type": "boolean",
            "description": "Opt this combo out of free-first ordering."
          }
        }
      }
    },
    "breaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failures": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "default": 30000
        },
        "halfOpenSuccesses": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dailyUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "warnAtPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 80
        },
        "perProvider": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "default": 4096
        },
        "maxInputChars": {
          "type": "integer",
          "minimum": 1,
          "default": 400000
        },
        "blockPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logPrompts": {
          "type": "boolean",
          "default": false
        },
        "redactPiiInLogs": {
          "type": "boolean",
          "default": true
        },
        "inspectToolChannel": {
          "enum": [
            "off",
            "warn",
            "block"
          ],
          "default": "off",
          "description": "B6.3: inspect tool definitions and tool results as well as the prompt."
        },
        "maxToolResultChars": {
          "type": "integer",
          "minimum": 100,
          "default": 20000
        }
      }
    },
    "apiKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "allowedCombos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedModels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dailyUsd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Per-key spend cap, rolling on the local day."
          },
          "key_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the key. Preferred over `key`, which is stored in plaintext."
          },
          "rateLimit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rpm": {
                "type": "number",
                "minimum": 0
              },
              "burst": {
                "type": "number",
                "minimum": 1
              }
            }
          },
          "guardrails": {
            "type": "object",
            "description": "Tighter guardrails for this key only (maxOutputTokens wins over the request).",
            "properties": {
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "paid_tiers": {
      "type": "object",
      "additionalProperties": false,
      "description": "The paid air-gap. While disabled, a paid provider's credentials are never read.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "vaultPath": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Background jobs. Off the request path by construction (I1).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "kickoffMs": {
          "type": "integer",
          "minimum": 0,
          "default": 1500
        },
        "cacheSweepMs": {
          "type": "integer",
          "minimum": 0,
          "default": 300000
        },
        "prober": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 1000,
              "default": 3600000
            },
            "failuresBeforeDisable": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "default": 8000
            }
          }
        }
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "description": "Prompt compression. Off by default: it changes what the model sees.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "preset": {
          "enum": [
            "auto",
            "lite",
            "standard",
            "aggressive",
            "ultra"
          ],
          "default": "auto"
        },
        "minChars": {
          "type": "integer",
          "minimum": 0,
          "default": 400
        },
        "keepLastUserMessage": {
          "type": "boolean",
          "default": true
        },
        "outputStyle": {
          "enum": [
            "off",
            "auto",
            "terse",
            "explanatory",
            "bullet",
            "code_only"
          ],
          "default": "off",
          "description": "B4.4 output axis: a short directive that shapes the answer's length and form."
        }
      }
    },
    "prompt_cache": {
      "type": "object",
      "additionalProperties": false,
      "description": "B4.6 native prompt caching: a stable prefix gets the hint its provider understands.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "description": "B3.4 verification escalation. Off by default: it costs a second call when an answer is weak.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7
        },
        "maxEscalations": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "escalateTo": {
          "enum": [
            "next"
          ],
          "default": "next"
        },
        "grounding": {
          "enum": [
            "off",
            "warn",
            "block"
          ],
          "default": "off",
          "description": "B7.6: check that URLs, quotes and numbers in the answer appear in the context it was given."
        }
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "description": "B9.2 canary rollout: a share of traffic to a candidate combo, with SLO-tied rollback. Off by default.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline": {
          "type": "string"
        },
        "candidate": {
          "type": "string"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 10
        },
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minSuccessRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.9
            },
            "maxP95Ms": {
              "type": "integer",
              "minimum": 1,
              "default": 8000
            },
            "minSamples": {
              "type": "integer",
              "minimum": 1,
              "default": 20
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "description": "B6.5 privacy tier. 'any' by default; a request may ask for stricter via the x-sui-privacy header.",
      "properties": {
        "defaultTier": {
          "enum": [
            "any",
            "standard",
            "strict"
          ],
          "default": "any"
        },
        "region": {
          "enum": [
            "any",
            "eu",
            "us",
            "in",
            "uk",
            "apac"
          ],
          "default": "any"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "description": "B3.1 free-first: a free target ranks before a paid one unless a combo opts out.",
      "properties": {
        "freeFirst": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "planes": {
      "type": "object",
      "additionalProperties": false,
      "description": "B5.7: split the gateway into a model plane (holds keys, has egress) and an agent plane (faces agents, holds no keys).",
      "properties": {
        "role": {
          "enum": [
            "both",
            "model",
            "agent"
          ],
          "default": "both"
        },
        "modelPlaneUrl": {
          "type": "string",
          "description": "Where the agent plane forwards to."
        },
        "serviceTokenEnv": {
          "type": "string",
          "default": "SUI_PLANE_TOKEN"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "description": "What the dashboard may do on your behalf. Everything here is a network or spend action, so it is off unless you ask.",
      "additionalProperties": false,
      "properties": {
        "allowProbe": {
          "type": "boolean",
          "default": false,
          "description": "Let the Providers card send one real probe request to one endpoint per click. It reports what answered; it never promotes a route. Off the loopback interface it also needs SUI_ADMIN_TOKEN."
        }
      }
    }
  }
}
