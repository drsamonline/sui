{
  "_comment": "A deliberately different-shaped config, for exercising `sui migrate`. Keys are fake.",
  "version": 2,
  "connections": {
    "groq": {
      "type": "openai",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key": "gsk_fake_key_for_the_demo"
